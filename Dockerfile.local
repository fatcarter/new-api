# Local build variant of Dockerfile: resolves the version from git tags when the
# repository's VERSION file is empty. Pair it with compose.yml, which passes the
# repository's .git directory as an additional build context named "gitdir":
#
#   build:
#     context: /app/sources/new-api
#     dockerfile: Dockerfile.local
#     additional_contexts:
#       gitdir: /app/sources/new-api/.git
#
# Plain `docker build` without --build-context gitdir=... falls back to VERSION.
# The release Dockerfile is untouched; the published images keep using it.

# Git metadata for local builds. Empty when the gitdir context is not supplied.
FROM scratch AS gitdir

# Resolve the version the same way the release workflow does: a non-empty
# VERSION file wins, otherwise use `git describe --tags --match 'v[0-9]*'`.
FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc AS version

RUN apk add --no-cache git
WORKDIR /src
COPY VERSION ./
COPY --from=gitdir . ./.git
RUN set -eu; \
    version=$(tr -d '\r\n' < VERSION); \
    if [ -z "$version" ] && [ -f .git/HEAD ]; then \
        version=$(git -c safe.directory='*' --git-dir=.git describe --tags --match 'v[0-9]*' 2>/dev/null \
            || git -c safe.directory='*' --git-dir=.git describe --tags --always 2>/dev/null \
            || true); \
    fi; \
    [ -n "$version" ] || version=unknown; \
    printf '%s\n' "$version" > /VERSION

FROM oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 AS builder

WORKDIR /build/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY ./web ./
COPY --from=version /VERSION /build/VERSION
RUN DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=$(cat /build/VERSION) bun run build

FROM golang:1.26.10-alpine@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca AS builder2
ENV GO111MODULE=on CGO_ENABLED=0 GOWORK=off

ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc

WORKDIR /build

ADD go.mod go.sum ./
# relaykit and tokenkit are local submodules referenced via replace; their
# go.mod files must be present for go mod download to resolve the main module graph.
ADD relaykit/go.mod ./relaykit/go.mod
ADD tokenkit/go.mod ./tokenkit/go.mod
RUN go mod download

COPY . .
COPY --from=version /VERSION ./VERSION
COPY --from=builder /build/web/dist ./web/dist
RUN go build -pgo="$(go list -m -f '{{.Dir}}' github.com/Calcium-Ion/moejs)/default.pgo" -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o new-api

FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata libasan8 wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

COPY --from=builder2 /build/new-api /
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
